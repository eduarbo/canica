+
+private:
+	struct Bar
+	{
+		float x, y, cell, height;
+		int full;
+	};
+
+	Window::PopupStyle mStyle;
+	TerminalStyle::TextLayer mText;
+	Vector4f mBox;
+	float mBar;
+	float mFoot;
+	std::vector<Bar> mBars;
+};
