#!/usr/bin/python3 -IS
"""Use configgen's normal launch and choose a resume point after its gameStart hooks.

The launch also waits less (speed_up): the game's hook scripts run side by side, evmapy starts
while RetroArch does, configgen's fixed half second after the game is dropped, and the emulator
waits only for the menu (started at the same time) to let go of the screen.

And it skips loading configgen: this file with --serve stays loaded after a launch (the warm
launcher), and the next launches run in forks of it. Without one, a launch runs here as before
and starts one for the next."""
import os
import sys

WARM = "/var/run/canica/launcher.sock"


def warm_launch(argv, path=WARM):
    """Hand this launch to the warm launcher: its arguments, folder, environment and standard
    streams. Returns the launch's exit code, or None when there is no warm launcher or it declined
    (the launch then runs here). Kept to built-in modules: Python starts in a tenth of a second."""
    import _socket
    conn = _socket.socket(_socket.AF_UNIX, _socket.SOCK_STREAM)
    try:
        try:
            conn.settimeout(0.5)
            conn.connect(path)
            import marshal
            payload = marshal.dumps((os.getcwd(), list(argv), dict(os.environ)))
            streams = b"".join(fd.to_bytes(4, sys.byteorder) for fd in (0, 1, 2))
            conn.sendmsg([len(payload).to_bytes(4, "big") + payload],
                         [(_socket.SOL_SOCKET, _socket.SCM_RIGHTS, streams)])
            if conn.recv(1) != b"A":
                return None
        except OSError:
            return None
        conn.settimeout(None)
        status = b""
        while len(status) < 4:
            try:
                chunk = conn.recv(4 - len(status))
            except InterruptedError:
                continue
            if not chunk:
                return 1      # the warm launcher went away during the game
            status += chunk
        return int.from_bytes(status, "big", signed=True)
    finally:
        conn.close()


if __name__ == "__main__" and sys.argv[1:2] != ["--serve"]:
    code = warm_launch(sys.argv)
    if code is not None:
        sys.exit(code)

if sys.flags.no_site:        # -S above: the system site-packages, where configgen lives
    import site
    site.main()

